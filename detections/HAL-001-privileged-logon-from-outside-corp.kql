// HAL-001: Privileged account network logon from outside the corporate subnet
//
// Why: in Phase 3 a scanner signed in as a Domain Admin 3,196 times from the
// attacker subnet and nothing alerted. An attacker with a stolen admin
// password would look exactly the same.
// MITRE ATT&CK: T1078.002 Valid Accounts: Domain Accounts;
//               T1021.002 Remote Services: SMB/Windows Admin Shares
// Data: SecurityEvent 4624 (successful logon) from DC01 and WS01
// Severity: High
//
// Tuning: logons are ignored ONLY when the account, source IP AND time all
// match an approved scan window in the ApprovedScanWindows watchlist
// (detections/watchlists/approved-scan-windows.csv). The same scanner account
// outside its window, or from any other address, still alerts.

let PrivilegedAccounts = dynamic(["svc-nessus", "d.evans", "haldaneadmin"]);
let CorpSubnet = "10.10.1.0/24";
// Columns are read from WatchlistItem, which always exists, so the rule
// still validates before the watchlist's rows have been indexed.
let ScanWindows = _GetWatchlist('ApprovedScanWindows')
    | project Account  = tolower(tostring(WatchlistItem.Account)),
              SourceIP = tostring(WatchlistItem.SourceIP),
              StartUtc = todatetime(WatchlistItem.StartUtc),
              EndUtc   = todatetime(WatchlistItem.EndUtc);
let Logons = SecurityEvent
    | where TimeGenerated > ago(7d)
    | where EventID == 4624                          // successful logon
    | where LogonType == 3                           // over the network
    | where TargetUserName in~ (PrivilegedAccounts)  // a privileged account
    | where isnotempty(IpAddress) and IpAddress != "-"
    | where not(ipv4_is_in_range(IpAddress, CorpSubnet))  // from outside corp
    | extend Account = tolower(TargetUserName);
let ApprovedScanLogons = Logons
    | join kind=inner ScanWindows on Account, $left.IpAddress == $right.SourceIP
    | where TimeGenerated between (StartUtc .. EndUtc)
    | project _ItemId;
Logons
| where _ItemId !in (ApprovedScanLogons)
| summarize Logons = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by TargetUserName, IpAddress, Computer
| order by Logons desc
